# Copia este archivo a .env. La llave hace falta solo si VOZ_MODELO es claude.
ANTHROPIC_API_KEY=
# El modelo que piensa: claude u ollama. Whisper y Piper son locales siempre.
VOZ_MODELO=claude
# El tamaño de Whisper: tiny, base, small, medium o large-v3. Más grande oye mejor y tarda más.
VOZ_WHISPER=small
# La voz de Piper. Se baja sola la primera vez.
VOZ_PIPER=es_MX-claude-high
# Segundos de silencio antes de dar por terminado el turno.
VOZ_SILENCIO=0.2
# La hora del consultorio.
VOZ_ZONA=America/Mexico_City
