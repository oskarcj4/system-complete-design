# Copia este archivo a .env. La llave hace falta si el modelo o el juez es claude.
ANTHROPIC_API_KEY=
# El modelo que responde: claude u ollama.
DOCS_MODELO=claude
# El que califica en los evals de respuesta: claude u ollama.
DOCS_JUEZ=claude
